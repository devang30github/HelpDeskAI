APP_NAME=HelpDeskAI
ENVIRONMENT=development

# DATABASE_URL=sqlite:///./data/helpdesk.db

# Dev-only admin guard. Replace with real authentication before any deployment.
ADMIN_API_KEY=change-me-dev-only

# Employee login tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# RAG settings (defaults shown)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=4
RETRIEVER_NAME=dense_v1

# LLM (used from Stage 3)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
# GROQ_REASONING_EFFORT=low
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048
INTENT_MAX_TOKENS=768
HISTORY_MESSAGES=6